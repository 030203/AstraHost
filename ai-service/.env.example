# Copy to .env and fill in your own keys. Do not commit .env.

AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5001
FRONTEND_BASE_URL=http://localhost:5400
BOOKING_SERVICE_BASE_URL=http://127.0.0.1:8080/api

# LLM (required for chat)
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: intent router (comma-separated keys)
# XIAOMI_API_KEYS=key1,key2
# XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1
# XIAOMI_MODEL=mimo-v2-flash

# Optional: external tools
# TAVILY_API_KEY=your_tavily_api_key
# OPENWEATHER_API_KEY=your_openweather_api_key

# Session / dev
CONVERSATION_TTL_SECONDS=86400
CONVERSATION_MAX_MESSAGES=20
ALLOW_MOCK_USER_CONTEXT=true

# Optional: Nacos
NACOS_DISCOVERY_ENABLED=false
NACOS_CONFIG_ENABLED=false
NACOS_SERVER_ADDR=127.0.0.1:8848
